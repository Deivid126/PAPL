# ============================================================
# PAPL — Backend — variáveis de ambiente
# Copie para .env e ajuste conforme necessário.
# NUNCA versione o arquivo .env real.
# ============================================================

# Porta HTTP da API
PORT=3000

# Modo de desenvolvimento (habilita caixa de e-mails em /dev/mails,
# reenvio de confirmação, etc.)
NODE_ENV=development

# URL do banco de dados PostgreSQL
DATABASE_URL="postgresql://papl:papl@localhost:5432/papl?schema=public"

# Chaves JWT (troque em produção)
JWT_ACCESS_SECRET="papl-access-secret-change-me"
JWT_REFRESH_SECRET="papl-refresh-secret-change-me"

# Expirações (em segundos)
JWT_ACCESS_EXPIRES_IN=900        # 15 minutos
JWT_REFRESH_EXPIRES_IN=604800    # 7 dias

# Validade dos tokens de confirmação/recuperação (segundos)
EMAIL_TOKEN_EXPIRES_IN=86400     # 24 horas
PASSWORD_TOKEN_EXPIRES_IN=3600   # 1 hora

# Origem permitida para o CORS (frontend)
CORS_ORIGIN="http://localhost:5173"

# E-mail: modo dev registra os e-mails no terminal e na tabela MailLog
MAIL_DRIVER=dev                    # "dev" | "smtp"
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PAPL <no-reply@example.com>"

# Blob storage: "local" | "s3" | "azure"
BLOB_DRIVER=local
# Diretório do storage local (relativo ao backend)
BLOB_LOCAL_DIR=./storage
# URL pública base para arquivos locais
BLOB_PUBLIC_BASE=http://localhost:3000

# S3 (quando BLOB_DRIVER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure Blob (quando BLOB_DRIVER=azure)
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER=
AZURE_CONNECTION_STRING=

# Seed: usuário de desenvolvimento criado pelo seed
SEED_DEV_EMAIL=avaliador@papl.dev
SEED_DEV_PASSWORD=Pap1@2024