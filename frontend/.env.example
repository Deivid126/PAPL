# URL da API (sem barra final). Em desenvolvimento, deixe vazio para usar
# o proxy do Vite (/api -> http://localhost:3000).
VITE_API_URL=

# Origem do back-end usada nos links de e-mail (CORS_ORIGIN no backend)
VITE_FRONTEND_URL=http://localhost:5173
# Base dos assets do protocolo (figuras das tarefas).
# Em desenvolvimento, deixe vazio para usar /storage via proxy do Vite.
# Em produção, aponte para o Vercel Blob, incluindo o prefixo. Ex.:
# VITE_STORAGE_URL=https://<store>.public.blob.vercel-storage.com/papl
VITE_STORAGE_URL=
